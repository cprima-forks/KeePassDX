{
  "casesFile": "../../app/sharedTest/resources/tel-link-cases.json",
  "customFieldName": "phone",
  "database": {
    "password": "test123",
    "userVerification": "disabled",
    "mode": "Modifiable",
    "why": "The password is a documented test value, not a secret. User verification off: the per-database toggle of KeePassDX, which removes the system prompt before an entry can be edited. Modifiable: the Edit button exists only for a database that is not read-only; the tests never save."
  },
  "dialogs": [
    {
      "name": "discard-changes",
      "match": {
        "message": "Discard changes?",
        "has_button": "Discard"
      },
      "answer": "Discard",
      "why": "Leaving edit mode asks this. A test never saves."
    },
    {
      "name": "lock-discard",
      "match": {
        "message": "Discard changes?",
        "has_button": "Lock"
      },
      "answer": "Lock",
      "why": "Locking asks this when the database holds unsaved changes. A test never saves, so nothing is lost; seeing it at all means something edited the database, and the report shows the rule used."
    },
    {
      "name": "database-changed",
      "match": {
        "text_contains": "has been modified outside the app"
      },
      "answer": "OK",
      "why": "The file changed on the phone while the app held it open (a push or a sync). OK only reads it again. Initialize closes the apps before the push, so this means the close step did not work."
    },
    {
      "name": "reload-discards",
      "match": {
        "text_contains": "Reloading the database will delete the locally modified data"
      },
      "answer": "Cancel",
      "why": "A reload that would throw away local changes. Cancel changes nothing."
    },
    {
      "name": "notification-permission",
      "match": {
        "text_contains": "The notification permission allows you to display the status of the database"
      },
      "answer": "Later",
      "why": "Android 13 asks once. Later does not open the system permission dialog and does not change a setting."
    },
    {
      "name": "clipboard-first-time",
      "match": {
        "text_contains": "The clipboard is shared by all apps"
      },
      "answer": "Disable",
      "why": "First tap on Copy of a protected field. Disable keeps the default (clipboard trust off)."
    },
    {
      "name": "password-encoding",
      "match": {
        "text_contains": "Avoid password characters outside of text encoding"
      },
      "answer": "Cancel",
      "why": "The unlock password has unusual characters. test123 never does; Cancel changes nothing."
    },
    {
      "name": "duplicate-uuid",
      "match": {
        "text_contains": "The database contains duplicate UUIDs"
      },
      "answer": "Cancel",
      "why": "The fixture is broken. Cancel, and the run fails at the unlock."
    },
    {
      "name": "mail-draft",
      "match": {
        "text": "Save draft message?"
      },
      "answer": "Discard",
      "why": "A tap on an e-mail address opens a composer; leaving it asks this. A test never saves a draft."
    },
    {
      "name": "popup-menu",
      "match": {
        "window_prefix": "PopupWindow"
      },
      "answer": "back",
      "why": "An overflow menu or a dropdown is a window named PopupWindow:<hash>, without an activity. It is not a modal to wait for: Back closes it."
    },
    {
      "name": "notification-shade",
      "match": {
        "window": "NotificationShade"
      },
      "answer": "command:cmd statusbar collapse",
      "why": "The notification panel covers the app and makes the screen dump fail. Closing it is a technical step."
    },
    {
      "name": "screen-locked",
      "match": {
        "window": "Keyguard"
      },
      "answer": "wait",
      "waitSeconds": 180,
      "why": "The phone locked itself. Only the person can unlock it; the test waits for them."
    },
    {
      "name": "user-verification",
      "match": {
        "window": "BiometricPrompt"
      },
      "answer": "wait",
      "waitSeconds": 180,
      "why": "Android asks the person to verify (PIN or fingerprint) before an entry can be edited. The test never enters a PIN: it waits for the person."
    }
  ],
  "scenarios": {
    "UI-LINK": {
      "title": "The link in view mode",
      "steps": [
        "Open the entry in view mode and look at the value. Which characters are underlined?"
      ]
    },
    "UI-TAP": {
      "title": "Tap",
      "steps": [
        "Tap the underlined number. Android may ask which app opens it; choose the Phone app. Look at the dialpad: does it hold the number? Do NOT press the call button. Go back."
      ]
    },
    "UI-LONGPRESS": {
      "title": "Long-press",
      "steps": [
        "Long-press the underlined number. Which characters are highlighted? Which buttons does the toolbar show?"
      ]
    },
    "UI-CALL": {
      "title": "Call in the selection toolbar",
      "steps": [
        "After the long-press tap Call in the toolbar. What does the dialpad hold? Do NOT press the call button. Go back."
      ]
    },
    "UI-LONGPRESS-TWO": {
      "title": "Long-press with two numbers",
      "steps": [
        "Long-press the second number only. Is only that number highlighted? Tap Call: does the dialpad hold only the second number? Do NOT press the call button."
      ]
    },
    "UI-WRAP": {
      "title": "A number that wraps over two lines",
      "steps": [
        "The number is long enough to wrap. Is the underline continuous over both lines? Tap the part on the second line. Long-press the part on the second line: is the whole number highlighted?"
      ]
    },
    "UI-NOTEL": {
      "title": "No phone link where only another link is expected",
      "steps": [
        "Look at the value: only the web address or e-mail address may be a link, no part of it a phone link. A tap on the part with the number must open the web address, not the dialer. Go back."
      ]
    },
    "UI-NOLINK": {
      "title": "No link where none is expected",
      "steps": [
        "Look at the value: nothing may be underlined. Long-press the value: a single word is highlighted, as in any text."
      ]
    },
    "UI-WEB": {
      "title": "A web link",
      "steps": [
        "Tap the underlined address. Does the browser open? Go back."
      ]
    },
    "UI-MAIL": {
      "title": "An e-mail link",
      "steps": [
        "Is only the address underlined, and not the word in front of it? Tap it: does a mail app open? Go back without sending."
      ]
    },
    "UI-REOPEN": {
      "title": "Reopen the entry",
      "steps": [
        "Go back to the list and open the entry again. Is it shown exactly as before?"
      ]
    },
    "UI-EDIT": {
      "title": "Edit mode",
      "steps": [
        "Tap the pencil. In edit mode the value is a plain text field: no underline, the full text. Leave edit mode WITHOUT saving."
      ]
    },
    "UI-COPY": {
      "title": "Copy button",
      "steps": [
        "Tap the copy button next to the value, then paste somewhere (for example into a note app). What was copied: the whole value or only a part?"
      ]
    }
  },
