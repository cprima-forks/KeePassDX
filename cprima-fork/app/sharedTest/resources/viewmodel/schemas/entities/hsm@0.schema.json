{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdh.invalid/schemas/entities/hsm@0.schema.json",
  "$comment": "Licensed under CC-BY-4.0. A hardware security module or smart card, with its two PINs: the old profile's hsm.",
  "x-pdh-entity": {"name": "hsm", "version": 0},
  "title": "Hardware security module",
  "description": "A hardware security module or smart card with its PINs.",
  "type": "object",
  "required": ["Title"],
  "properties": {
    "Title": {"type": "string", "description": "The record's title."},
    "serial_number": {"type": "string", "description": "The manufacturer's serial number."},
