<?xml version="1.0" encoding="utf-8"?>
<!-- LinkLab (fork issue #15), debug variant only. Theme attributes only, so it follows the app theme. -->
<resources>

    <style name="LinkLab.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="LinkLab.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="LinkLab.Hint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="LinkLab.Mono" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textIsSelectable">true</item>
    </style>
</resources>
