# Copy to .env and adjust. .env is git-ignored.
# Format: KEY="value". Double quotes are required (just rejects unquoted values with spaces).
# Use forward slashes in paths.

# JDK 21 used to run Gradle and sdkmanager
JAVA_HOME="C:/Program Files/Eclipse Adoptium/jdk-21.0.12.101-hotspot"

# Android SDK root (created by fork-tools/Setup-AndroidBuild.ps1)
ANDROID_HOME="O:/android-sdk"

# Gradle distribution and dependency cache
GRADLE_USER_HOME="O:/gradle-home"

# Scratch folder for build temp files (TEMP and TMP of Gradle runs). Created on demand.
# Also set -Djava.io.tmpdir to this path in GRADLE_USER_HOME/gradle.properties.
BUILD_TMP="T:/Android/build-tmp"

# Default adb device (output of `adb devices`). Identifies a device: keep it
# in .env only, never in this file.
ANDROID_SERIAL=""
